{
  "name": "devbox-client",
  "version": "0.1.0",
  "description": "Microsoft Dev Box client: list, start/stop and connect to your Dev Boxes with Entra ID",
  "main": "src/main.js",
  "license": "MIT",
  "author": {
    "name": "Ivan",
    "email": "bym666@gmail.com"
  },
  "homepage": "https://github.com/ivan-vercinsky/devbox-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivan-vercinsky/devbox-client.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/render-icon.js",
    "dist": "electron-builder --linux deb --publish never",
    "dist:linux": "electron-builder --linux deb --publish never",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "local.devbox.client",
    "productName": "Dev Box",
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "desktop": {
        "entry": {
          "Keywords": "devbox;rdp;remote;desktop;azure;"
        }
      }
    },
    "deb": {
      "synopsis": "Microsoft Dev Box client (Entra ID + FreeRDP)",
      "description": "Lists your Microsoft Dev Boxes, starts and stops them, and connects to them with FreeRDP 3 - signed in with your organization's Entra ID account, with no tenant admin rights or app registration needed.",
      "fpm": [
        "build/local.devbox.client.metainfo.xml=/usr/share/metainfo/local.devbox.client.metainfo.xml"
      ],
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "freerdp3-sdl | freerdp3-x11"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp"
    }
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
